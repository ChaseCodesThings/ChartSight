# Copy to .env and fill in. Never commit .env.

# --- main model ---------------------------------------------------------
# Claude:
CHARTSIGHT_PROVIDER=anthropic
CHARTSIGHT_MODEL=claude-sonnet-5-5
CHARTSIGHT_API_KEY=sk-ant-...
# OpenAI (or any OpenAI-compatible server, see below):
# CHARTSIGHT_PROVIDER=openai
# CHARTSIGHT_MODEL=<a vision-capable model name>
# CHARTSIGHT_API_KEY=sk-...
# Open-weight model on your own machine with Ollama (`ollama pull qwen2.5vl:7b`):
# CHARTSIGHT_PROVIDER=openai
# CHARTSIGHT_BASE_URL=http://localhost:11434/v1
# CHARTSIGHT_MODEL=qwen2.5vl:7b

# Prices in USD per million tokens, from your provider's pricing page.
# Leave blank to report tokens only.
CHARTSIGHT_PRICE_IN=
CHARTSIGHT_PRICE_OUT=

# --- optional separate judge model for --judge ---------------------------
# CHARTSIGHT_JUDGE_PROVIDER=anthropic
# CHARTSIGHT_JUDGE_MODEL=...
# CHARTSIGHT_JUDGE_API_KEY=...
